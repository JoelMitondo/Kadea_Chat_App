        <mxCell id="whpXm5Y-3T501-Lfjxlo-399" parent="1" style="text;html=1;fontSize=20;fontStyle=1;align=left;" value="MLD — Kadea Chat (PostgreSQL)" vertex="1">
          <mxGeometry height="36" width="500" x="-460" as="geometry" />
        </mxCell>
        <mxCell id="whpXm5Y-3T501-Lfjxlo-400" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fontSize=12;strokeColor=#7A8B9C;fillColor=none;" value="Légende : PK = clé primaire (souligné) · FK = clé étrangère (italique) · NULL = colonne facultative.&lt;br&gt;Relations : patte d&#39;oie côté table qui porte la FK (0..N), barre côté table référencée (1 obligatoire, 0..1 si la FK est NULL).&lt;br&gt;Contraintes d&#39;unicité : user_conversations(user_id, conversation_id) · message_recipients(user_id, message_id) · message_statuses(message_id, user_id) · blocked_users(blocker_id, blocked_id)." vertex="1">
          <mxGeometry height="90" width="720" x="-460" y="980" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
