{{--
  Aperçu d'une story : une TOUTE PETITE image très floue (quelques Ko).
  La vraie image n'est téléchargée que si l'on clique dessus (voir stories.js).
  Props : story, author (name, initials, avatarUrl)
--}}
@let(story = $props.get('story'))
@let(author = $props.get('author'))

{{-- Les data-... portent tout ce dont la visionneuse a besoin : stories.js les lit au clic --}}
<button
  type="button"
  data-story
  data-blur-url="{{ story.blurUrl }}"
  data-full-url="{{ story.fullUrl }}"
  data-caption="{{ story.caption }}"
  data-author-name="{{ author.name }}"
  data-author-initials="{{ author.initials }}"
  data-author-avatar="{{ author.avatarUrl }}"
  data-posted="{{ story.postedAgo }}"
  data-expires-at="{{ story.expiresAt }}"
  aria-label="Voir la story de {{ author.name }}"
  class="relative aspect-[9/16] w-28 flex-none cursor-pointer overflow-hidden rounded-xl border border-line bg-surface-2 sm:w-32"
>
  {{-- L'aperçu flou : loading="lazy" = il n'est même pas téléchargé tant qu'on ne fait pas défiler jusqu'à lui --}}
  <img src="{{ story.blurUrl }}" alt="" loading="lazy" class="h-full w-full scale-105 object-cover">

  {{-- Icône qui indique "touchez pour télécharger et voir" --}}
  <span class="absolute inset-0 flex items-center justify-center bg-black/20">
    <span class="flex h-10 w-10 items-center justify-center rounded-full bg-black/50 text-white">
      <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
        <polyline points="7 10 12 15 17 10" />
        <line x1="12" y1="15" x2="12" y2="3" />
      </svg>
    </span>
  </span>

  {{-- Heure de publication et temps restant --}}
  <span class="absolute inset-x-0 bottom-0 bg-black/55 px-2 py-1.5 text-left text-[11px] text-white">
    <span class="block truncate">{{ story.postedAgo }}</span>
    <span data-time-left class="block truncate text-white/75">Expire dans {{ story.timeLeft }}</span>
  </span>
</button>