{{-- Une bulle de message. Prop : message (voir construitVueMessage) --}}
@let(message = $props.get('message'))
@let(bubbleClasses = message.isMine
  ? 'rounded-br-md bg-bubble-out text-on-bubble-out'
  : 'rounded-bl-md border border-bubble-line bg-bubble-in text-on-bubble-in')

<div data-message-id="{{ message.id }}" class="group flex items-end gap-1.5 {{ message.isMine ? 'justify-end' : 'justify-start' }}">

  {{-- Modifier / supprimer : seulement mes messages non supprimés.
       Un message avec un fichier ne peut pas être modifié, seulement supprimé. --}}
  @if(message.isMine && !message.isDeleted)
    <div class="flex flex-none gap-1 md:opacity-0 md:transition-opacity md:group-hover:opacity-100">
      @if(!message.attachment)
        <button type="button" data-edit-message title="Modifier" aria-label="Modifier le message" class="cursor-pointer rounded-full p-1.5 text-fg-subtle hover:bg-surface-2 hover:text-fg">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M12 20h9" />
            <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z" />
          </svg>
        </button>
      @end
      <button type="button" data-delete-message title="Supprimer" aria-label="Supprimer le message" class="cursor-pointer rounded-full p-1.5 text-fg-subtle hover:bg-danger-soft hover:text-danger">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
          <polyline points="3 6 5 6 21 6" />
          <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
          <path d="M10 11v6M14 11v6" />
          <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />
        </svg>
      </button>
    </div>
  @end

  <div class="max-w-[80%] rounded-2xl px-3.5 py-2 {{ bubbleClasses }}">

    {{-- Dans un groupe : le nom de l'auteur --}}
    @if(message.senderName)
      <p class="mb-0.5 text-xs font-semibold text-group">{{ message.senderName }}</p>
    @end

    @if(message.isDeleted)
      <p class="italic opacity-70">Ce message a été supprimé</p>
    @else

      {{-- ===== Le fichier joint ===== --}}
      @if(message.attachment)

        @if(message.attachment.isImage)
          {{-- Image : une miniature légère, un clic l'ouvre en grand dans un nouvel onglet --}}
          <a href="{{ message.attachment.url }}" target="_blank" rel="noopener" class="block">
            <img src="{{ message.attachment.thumbUrl }}" alt="{{ message.attachment.name }}" loading="lazy" class="mb-1 max-h-60 rounded-xl object-cover">
          </a>
        @else
          {{-- Document : nom --}}
          <div class="mb-1 flex items-center gap-3 rounded-xl bg-black/10 p-3">
            <svg class="h-8 w-8 flex-none" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
              <polyline points="14 2 14 8 20 8" />
              <line x1="8" y1="13" x2="16" y2="13" />
              <line x1="8" y1="17" x2="16" y2="17" />
            </svg>
            <div class="min-w-0">
              <p class="truncate text-sm font-medium">{{ message.attachment.name }}</p>
            </div>
          </div>
        @end

        {{-- Taille, puis consulter ou télécharger --}}
        <p class="mb-1 flex flex-wrap gap-1.5 text-xs">
          <span>{{ message.attachment.size }}</span>
          <span aria-hidden="true">·</span>
          <a href="{{ message.attachment.url }}" target="_blank" rel="noopener" class="underline">Ouvrir</a>
          <span aria-hidden="true">·</span>
          <a href="{{ message.attachment.downloadUrl }}" class="underline">Télécharger</a>
        </p>
      @end

      {{-- Le texte (facultatif quand il y a un fichier) --}}
      @if(message.content)
        <p data-message-text class="whitespace-pre-wrap break-words">{{ message.content }}</p>
      @end
    @end

    <div class="mt-1 flex items-center justify-end gap-1.5 text-[11px] opacity-80">
      @if(message.isEdited && !message.isDeleted)
        <span>modifié</span>
      @end
      <span>{{ message.time }}</span>

      @if(message.isMine && !message.isDeleted)
        {{-- Trois états, un seul visible (message.js les change en direct) :
             une coche grise = envoyé, deux coches grises = reçu, deux coches bleues = lu --}}
        <span data-tick-read aria-label="Lu" class="{{ message.isRead ? '' : 'hidden' }}">
          <svg class="h-4 w-4 text-azure-300" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M18 6 7 17l-5-5" />
            <path d="m22 10-7.5 7.5L13 16" />
          </svg>
        </span>
        <span data-tick-delivered aria-label="Reçu" class="{{ !message.isRead && message.isDelivered ? '' : 'hidden' }}">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M18 6 7 17l-5-5" />
            <path d="m22 10-7.5 7.5L13 16" />
          </svg>
        </span>
        <span data-tick-sent aria-label="Envoyé" class="{{ message.isRead || message.isDelivered ? 'hidden' : '' }}">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <polyline points="20 6 9 17 4 12" />
          </svg>
        </span>
      @end
    </div>
  </div>
</div>