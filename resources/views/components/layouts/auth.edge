<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  {{-- Le titre change selon la page (ex. "Créer un compte") --}}
  <title>{{ $props.get('title', 'Kadea Chat') }}</title>

  {{--
    Ce petit script s'exécute AVANT l'affichage de la page.
    Il applique le thème choisi (clair ou sombre) pour éviter un flash blanc.
  --}}
  <script>
    var themeSauvegarde = localStorage.getItem('theme')
    var themeDuSysteme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
    document.documentElement.dataset.theme = themeSauvegarde || themeDuSysteme
  </script>

  <link rel="stylesheet" href="/resources/css/output.css">
  <link rel="stylesheet" href="/resources/css/animate.css">
  <script type="module" src="/resources/js/auth/register.js" defer></script>
</head>

<body class="flex min-h-screen flex-col bg-canvas text-fg antialiased">
  {{-- Le chargeur (affiché au chargement, puis géré par loader.js) --}}
  @!component('components/loader')

  {{-- ===== EN-TÊTE : logo à gauche, bouton de thème à droite ===== --}}
  <header class="border-b border-line bg-surface">
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">

      {{-- Le logo est un lien vers la page d'accueil --}}
      <a href="/" class="flex items-center gap-2.5" aria-label="Retour à l'accueil de Kadea Chat">
        <img src="/resources/public/images/logoKadea.png" alt="logo kadea Chat" class="h-9 w-9">
        <span class="text-xl font-bold">
          <span class="text-navy-800 dark:text-white">Kadea</span>
          <span class="text-azure-500">Chat</span>
        </span>
      </a>

      {{-- Bouton pour changer de thème --}}
      <button
        id="theme-toggle"
        type="button"
        aria-label="Changer de thème"
        class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border border-line bg-surface text-fg-muted hover:bg-surface-2"
      >
        {{-- Icône lune : visible en mode clair (clic = passer en sombre) --}}
        <svg class="h-5 w-5 dark:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
        {{-- Icône soleil : visible en mode sombre (clic = passer en clair) --}}
        <svg class="hidden h-5 w-5 dark:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="4" />
          <path stroke-linecap="round" d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>

    </div>
  </header>

  {{-- ===== CONTENU DE LA PAGE ===== --}}
  <main class="flex flex-1 items-center justify-center px-4 py-10">
    {{-- Ici s'affiche le contenu de chaque page (inscription, connexion...) --}}
    {{{ await $slots.main() }}}
  </main>

  {{-- ===== PIED DE PAGE ===== --}}
  <footer class="py-6 text-center text-sm text-fg-subtle">
    © 2026 Kadea Chat · Kadea Academy
  </footer>

  {{-- Script du bouton de thème --}}
  <script>
    var bouton = document.getElementById('theme-toggle')

    bouton.addEventListener('click', function () {
      var html = document.documentElement
      var nouveauTheme = html.dataset.theme === 'dark' ? 'light' : 'dark'

      html.dataset.theme = nouveauTheme
      localStorage.setItem('theme', nouveauTheme)
    })
  </script>
<script src="/resources/js/loader.js"></script>
</body>
</html>