<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>{{ $props.get('title', 'Kadea Chat') }}</title>
    <meta name="description" content="Kadea Chat : Application web de chat">

    <meta property="og:type" content="website">
    <meta property="og:url" content="https://agora-chat-app-1.onrender.com/"> 
    <meta property="og:title" content="Kadea Chat | Application web de conversation">
    <meta property="og:description" content="Application web de chat.">
    <meta property="og:image" content="https://i.ibb.co/zVsVm0NQ/Screenshot-17.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">

    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="https://agora-chat-app-1.onrender.com/">
    <meta property="twitter:title" content="Kadea Chat | Application web de conversation">
    <meta property="twitter:description" content="Application web de chat.">
    <meta property="twitter:image" content="https://i.ibb.co/zVsVm0NQ/Screenshot-17.png"> 
    <meta name="theme-color" content="#2563eb">
    
    <link rel="icon" href="https://i.ibb.co/1YhrGKHz/logo-Kadea.png" type="image/png">

  {{-- script s'execute avant l'affichage de la page pour eviter des pages blaches.--}}
  <script>
    let themeSauvegarde = localStorage.getItem('theme')
    let themeDuSysteme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
    document.documentElement.dataset.theme = themeSauvegarde || themeDuSysteme
  </script>

  @vite(['resources/css/compiles/app.css'])
</head>

<body class="flex min-h-screen flex-col bg-canvas text-fg antialiased">
  {{-- Le chargeur (affiché au chargement, puis géré par loader.js) --}}
  @!component('components/loader')
  @!component('components/toasts')

  <header class="border-b border-line bg-surface">
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">

      {{-- Le logo est un lien vers la page d'accueil --}}
      <a href="/" class="flex items-center gap-2.5" aria-label="Retour à l'accueil de Kadea Chat">
        <img src="https://i.ibb.co/MxSRtHyW/logo-Kadea.png" alt="logo Kadea Chat" class="h-9 w-9">
        <span class="text-xl font-bold">
          <span class="text-navy-800 dark:text-white">Kadea</span>
          <span class="text-azure-500">Chat</span>
        </span>
      </a>

      {{-- Bouton pour changer de thème --}}
      <button
        id="theme-toggle"
        type="button"
        aria-label="Changer de thème"
        class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border border-line bg-surface text-fg-muted hover:bg-surface-2"
      >
        {{-- Icône lune : mode clair --}}
        <svg class="h-5 w-5 dark:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
        {{-- Icône soleil mode sombre --}}
        <svg class="hidden h-5 w-5 dark:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="4" />
          <path stroke-linecap="round" d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>

    </div>
  </header>

  {{-- CONTENU  --}}
  <main class="flex flex-1 items-center justify-center px-4 py-10">
    
    {{{ await $slots.main() }}}
  </main>

  {{-- PIED DE PAGE --}}
  <footer class="py-6 text-center text-sm text-fg-subtle">
    © 2026 Kadea Chat · NMS Tech
  </footer>

  {{-- Script du bouton de thème --}}
  <script>
    let bouton = document.getElementById('theme-toggle')

    bouton.addEventListener('click', function () {
      let html = document.documentElement
      let nouveauTheme = html.dataset.theme === 'dark' ? 'light' : 'dark'

      html.dataset.theme = nouveauTheme
      localStorage.setItem('theme', nouveauTheme)
    })
  </script>
   
 @vite(['resources/js/compiles/auth.js']) 
 @vite(['resources/js/compiles/animate.js'])
</body>
</html>