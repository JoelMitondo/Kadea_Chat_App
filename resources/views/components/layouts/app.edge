<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ $props.get('title', 'Kadea Chat') }}</title>
    
    <meta name="description" content="Kadea Chat : Application web de chat">

    <meta property="og:type" content="website">
    <meta property="og:url" content="https://joelmitondo.github.io/cache-kadea-chat/"> 
    <meta property="og:title" content="Kadea Chat | Application web de conversation">
    <meta property="og:description" content="Application web de chat.">
    <meta property="og:image" content="https://i.ibb.co/zVsVm0NQ/Screenshot-17.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">

    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="https://joelmitondo.github.io/cache-kadea-chat/">
    <meta property="twitter:title" content="Kadea Chat | Application web de conversation">
    <meta property="twitter:description" content="Application web de chat.">
    <meta property="twitter:image" content="https://i.ibb.co/zVsVm0NQ/Screenshot-17.png"> 
    <meta name="theme-color" content="#2563eb">
    
    <link rel="icon" href="https://i.ibb.co/1YhrGKHz/logo-Kadea.png" type="image/png">

  <meta name="csrf-token" content="{{ csrfToken }}">
  {{-- Application du thème sombre ou clair avant l'affichage, pour éviter un flash --}}
  <script>
    let themeSauvegarde = localStorage.getItem('theme')
    let themeDuSysteme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
    document.documentElement.dataset.theme = themeSauvegarde || themeDuSysteme
  </script>

  <link rel="stylesheet" href="/resources/css/output.css">
  <link rel="stylesheet" href="/resources/css/animate.css">
  {{-- charge realtime.js (il passe par Vite) --}}
  @vite(['resources/js/realtime.js'])
</head>

<body class="bg-canvas text-fg antialiased" data-user-id="{{ auth.user.id }}">

  @!component('components/loader')
  @!component('components/toasts')

  {{-- L'écran est découpé en hauteur : l'en-tête en haut, le reste dessous --}}
  <div class="flex h-dvh flex-col">

    {{-- ==========================================================
         ZONE 1 : BARRE DU HAUT
         ========================================================== --}}
    <header class="flex h-16 flex-none items-center justify-between gap-4 border-b border-line bg-surface px-4 sm:px-6">

      {{-- Gauche : le nom (le logo n'apparaît ici que sur téléphone) --}}
      <a href="/messages" class="flex items-center gap-2.5" aria-label="Kadea Chat, retour aux messages">
        <img src="/resources/public/images/logoKadea.png" alt="" class="h-8 w-8 md:hidden">
        <span class="text-xl font-bold">
          <span class="text-navy-800 dark:text-white">Kadea</span>
          <span class="text-azure-500">Chat</span>
        </span>
      </a>

      {{-- Centre : recherche dans les messages (cachée sur téléphone) --}}
      <form action="/search" method="GET" class="hidden max-w-md flex-1 md:block">
        <div class="relative">
          <svg class="pointer-events-none absolute left-3 top-1/2 h-5 w-5 -translate-y-1/2 text-fg-subtle" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
          <input
            type="search"
            name="q"
            placeholder="Rechercher un message…"
            class="w-full rounded-full border border-line bg-surface-2 py-2 pl-10 pr-4 text-sm text-fg placeholder:text-fg-subtle focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/30"
          >
        </div>
      </form>

      {{-- Droite : boutons d'action --}}
      <div class="flex items-center gap-1">
        {{-- Recherche : visible seulement sur téléphone (sur ordinateur, la barre du centre est utilisée) --}}
        <a href="/search" title="Rechercher" aria-label="Rechercher un message" class="flex h-10 w-10 items-center justify-center rounded-full text-fg-muted hover:bg-surface-2 hover:text-fg md:hidden">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
        </a>
        
        {{-- Changer de thème --}}
        <button id="theme-toggle" type="button" title="Changer de thème" aria-label="Changer de thème" class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-full text-fg-muted hover:bg-surface-2 hover:text-fg">
          <svg class="h-5 w-5 dark:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
          </svg>
          <svg class="hidden h-5 w-5 dark:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="4" />
            <path stroke-linecap="round" d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
        </button>

        {{-- Paramètres --}}
        <a href="/settings" title="Paramètres" aria-label="Paramètres" class="flex h-10 w-10 items-center justify-center rounded-full text-fg-muted hover:bg-surface-2 hover:text-fg">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="3" />
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33h0a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51h0a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82v0a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
          </svg>
        </a>

        {{-- Déconnexion (un formulaire POST, plus sûr qu'un simple lien) --}}
        <form action="/logout" method="POST">
          {{ csrfField() }}
          <button type="submit" title="Se déconnecter" aria-label="Se déconnecter" class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-full text-fg-muted hover:bg-danger-soft hover:text-danger">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
              <polyline points="16 17 21 12 16 7" />
              <line x1="21" y1="12" x2="9" y2="12" />
            </svg>
          </button>
        </form>

      </div>
    </header>

    {{-- Sous l'en-tête : la barre de navigation + la zone du milieu.
         Téléphone : en colonne, la barre passe EN BAS (order-last).
         Ordinateur : en ligne, la barre passe À GAUCHE (md:order-first). --}}
    <div class="flex min-h-0 flex-1 flex-col md:flex-row">

      {{-- ==========================================================
           ZONE 2 : BARRE DE NAVIGATION
           ========================================================== --}}

      {{-- Cette boîte réserve 80 px de large : quand la barre s'agrandit au survol,
           elle passe PAR-DESSUS le contenu sans le pousser --}}
      <div class="order-last md:relative md:order-first md:w-20 md:flex-none">

        <nav
          aria-label="Navigation principale"
          class="kc-barre group flex flex-row items-center justify-around gap-1 overflow-hidden border-t border-line bg-surface px-2 py-1.5 md:absolute md:inset-y-0 md:left-0 md:z-30 md:w-20 md:flex-col md:items-stretch md:justify-start md:border-r md:border-t-0 md:px-3 md:py-3 md:transition-[width,box-shadow] md:duration-300 md:ease-out md:hover:w-60 md:hover:shadow-xl md:focus-within:w-60"
        >

          {{-- Logo (invisible sur téléphone) : quart de tour quand on survole la barre --}}
          <a href="/messages" class="kc-apparition mb-2 hidden h-14 items-center md:flex" aria-label="Kadea Chat">
            <span class="flex w-14 flex-none items-center justify-center">
              <img src="/resources/public/images/logoKadea.png" alt="" class="kc-logo h-9 w-9">
            </span>
            <span class="whitespace-nowrap text-lg font-bold opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-within:opacity-100">
              <span class="text-navy-800 dark:text-white">Kadea</span>
              <span class="text-azure-500">Chat</span>
            </span>
          </a>

          {{-- Messages --}}
          @component('components/nav-item', { href: '/messages', label: 'Messages', active: $props.get('active') === 'messages', delay: 100, badge: 'private' })
            <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
            </svg>
          @end

          {{-- Groupes --}}
          @component('components/nav-item', { href: '/groups', label: 'Groupes', active: $props.get('active') === 'groups', delay: 200, badge: 'group' })
            <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
              <circle cx="9" cy="7" r="4" />
              <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
              <path d="M16 3.13a4 4 0 0 1 0 7.75" />
            </svg>
          @end

          {{-- Utilisateurs --}}
          @component('components/nav-item', { href: '/users', label: 'Utilisateurs', active: $props.get('active') === 'users', delay: 300 })
            <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
              <circle cx="8.5" cy="7" r="4" />
              <line x1="20" y1="8" x2="20" y2="14" />
              <line x1="23" y1="11" x2="17" y2="11" />
            </svg>
          @end

          {{-- Stories --}}
          @component('components/nav-item', { href: '/stories', label: 'Stories', active: $props.get('active') === 'stories', delay: 400 })
            <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="9" stroke-dasharray="4 3" />
              <circle cx="12" cy="12" r="4" />
            </svg>
          @end

          {{-- Mon profil (poussé en bas de la barre sur ordinateur grâce à md:mt-auto) --}}
          @component('components/nav-item', { href: '/profile', label: 'Mon profil', active: $props.get('active') === 'profile', delay: 500, class: 'md:mt-auto' })
            <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
              <circle cx="12" cy="7" r="4" />
            </svg>
          @end

        </nav>
      </div>

      {{-- ==========================================================
           ZONE 3 : ESPACE DU MILIEU (le contenu de chaque page)
           ========================================================== --}}
      <main class="min-h-0 flex-1 overflow-y-auto">
        {{{ await $slots.main() }}}
      </main>

    </div>
  </div>

  <script>
    let bouton = document.getElementById('theme-toggle')

    bouton.addEventListener('click', function () {
      let html = document.documentElement
      let nouveauTheme = html.dataset.theme === 'dark' ? 'light' : 'dark'

      html.dataset.theme = nouveauTheme
      localStorage.setItem('theme', nouveauTheme)
    })
  </script>

  <script src="/resources/js/loader.js"></script>
  <script src="/resources/js/notifications.js"></script>
</body>
</html>