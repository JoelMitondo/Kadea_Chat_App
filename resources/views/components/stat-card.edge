{{-- Carte d'indicateur. Props : label, value, tone (primary | group | accent). Le slot contient l'icône. --}}
@let(tones = {
  primary: 'bg-primary-soft text-on-primary-soft',
  group: 'bg-group-soft text-group',
  accent: 'bg-accent-soft text-on-accent-soft',
})

<div class="flex items-center gap-4 rounded-2xl border border-line bg-surface p-5 shadow-sm">
  <span class="flex h-12 w-12 flex-none items-center justify-center rounded-xl {{ tones[$props.get('tone', 'primary')] }}">
    {{{ await $slots.main() }}}
  </span>
  <div class="min-w-0">
    <p class="text-2xl font-bold text-fg">{{ $props.get('value') }}</p>
    <p class="truncate text-sm text-fg-muted">{{ $props.get('label') }}</p>
  </div>
</div>