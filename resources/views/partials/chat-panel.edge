@if(chat)
  <div id="chat-panel" data-conversation-id="{{ chat.id }}" class="flex h-full min-h-0 flex-1 flex-col">

    {{-- ===== En-tête ===== --}}
    <header class="flex flex-none items-center gap-3 border-b border-line bg-surface px-3 py-3 sm:px-4">

      {{-- Bouton retour : visible UNIQUEMENT sur téléphone --}}
      <button type="button" data-chat-back aria-label="Retour à la liste des conversations" class="flex h-9 w-9 flex-none cursor-pointer items-center justify-center rounded-full text-fg-muted hover:bg-surface-2 hover:text-fg md:hidden">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
          <line x1="19" y1="12" x2="5" y2="12" />
          <polyline points="12 19 5 12 12 5" />
        </svg>
      </button>

      @!component('components/user-avatar', { initials: chat.other.initials, src: chat.other.avatarUrl, online: chat.other.isOnline, userId: chat.other.id, size: 'sm' })

      <div class="min-w-0">
        <p class="truncate font-semibold text-fg">{{ chat.other.name }}</p>

        {{-- data-presence-label : realtime.js change ce texte en direct --}}
        <p data-presence-label="{{ chat.other.id }}" class="flex items-center gap-1.5 text-xs {{ chat.other.isOnline ? 'font-medium text-success' : 'text-fg-subtle' }}">
          <span data-presence-pulse class="h-2 w-2 animate-pulse rounded-full bg-online {{ chat.other.isOnline ? '' : 'hidden' }}"></span>
          <span data-presence-text>{{ chat.other.isOnline ? 'En ligne' : 'Hors ligne' }}</span>
        </p>
      </div>
            {{-- Bloquer / débloquer cet utilisateur --}}
      @if(chat.blockedByMe)
        <button type="button" data-unblock-user data-user-id="{{ chat.other.id }}" class="flex-none cursor-pointer rounded-lg border border-line-strong px-3 py-1.5 text-sm font-semibold text-fg hover:bg-surface-2">
          Débloquer
        </button>
      @else
        <button type="button" data-block-user data-user-id="{{ chat.other.id }}" title="Bloquer cet utilisateur" aria-label="Bloquer cet utilisateur" class="flex h-9 w-9 flex-none cursor-pointer items-center justify-center rounded-full text-fg-muted hover:bg-danger-soft hover:text-danger">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10" />
            <line x1="4.93" y1="4.93" x2="19.07" y2="19.07" />
          </svg>
        </button>
      @end
    </header>
    @if(chat.blockedByMe)
      <div class="flex-none bg-warning-soft px-4 py-2 text-center text-sm text-warning">
        Vous avez bloqué {{ chat.other.name }}. Cette personne ne peut plus vous envoyer de messages.
      </div>
    @end
    {{-- ===== Messages ===== --}}
    <div id="messages-list" class="min-h-0 flex-1 space-y-2 overflow-y-auto bg-canvas px-3 py-4 sm:px-6">
      @if(chat.messages.length === 0)
        <p data-empty-notice class="py-10 text-center text-sm text-fg-subtle">Aucun message. Dites bonjour 👋</p>
      @end

      @each((message, index) in chat.messages)
        {{-- Un séparateur à chaque changement de jour --}}
        @if(index === 0 || message.dayKey !== chat.messages[index - 1].dayKey)
          @!component('components/day-separator', { label: message.dayLabel })
        @end
        @!component('components/message-bubble', { message })
      @end
    </div>

    {{-- chat-panel.edge (conversation privée) --}}
    @!component('components/composer', { action: route('messages.store', { id: chat.id }), placeholder: 'Écrire un message…' })
      </div>
    @else
  @include('partials/chat-empty')
@end