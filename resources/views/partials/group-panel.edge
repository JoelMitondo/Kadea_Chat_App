@if(chat)
  <div id="chat-panel" data-conversation-id="{{ chat.id }}" class="flex h-full min-h-0 flex-1 flex-col">

    {{-- ===== En-tête ===== --}}
    <header class="flex flex-none items-center gap-3 border-b border-line bg-surface px-3 py-3 sm:px-4">

      {{-- Bouton retour : visible UNIQUEMENT sur téléphone --}}
      <button type="button" data-chat-back aria-label="Retour à la liste des groupes" class="flex h-9 w-9 flex-none cursor-pointer items-center justify-center rounded-full text-fg-muted hover:bg-surface-2 hover:text-fg md:hidden">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
          <line x1="19" y1="12" x2="5" y2="12" />
          <polyline points="12 19 5 12 12 5" />
        </svg>
      </button>

      @!component('components/user-avatar', { initials: chat.group.initials, tone: 'group', size: 'sm', userId: member.id })

      <div class="min-w-0 flex-1">
        <p class="truncate font-semibold text-fg">{{ chat.group.name }}</p>
        <p class="text-xs text-fg-subtle">{{ chat.group.membersCount }} membres</p>
      </div>

      {{-- Icône : informations du groupe, membres, ajout de membres --}}
      <button type="button" data-group-info-open title="Informations du groupe" aria-label="Informations du groupe" class="flex h-9 w-9 flex-none cursor-pointer items-center justify-center rounded-full text-fg-muted hover:bg-surface-2 hover:text-fg">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10" />
          <line x1="12" y1="16" x2="12" y2="12" />
          <line x1="12" y1="8" x2="12.01" y2="8" />
        </svg>
      </button>
    </header>

    {{-- ===== Messages ===== --}}
    <div id="messages-list" class="min-h-0 flex-1 space-y-2 overflow-y-auto bg-canvas px-3 py-4 sm:px-6">
      @if(chat.messages.length === 0)
        <p data-empty-notice class="py-10 text-center text-sm text-fg-subtle">Aucun message. Lancez la discussion 👋</p>
      @end

      @each((message, index) in chat.messages)
        @if(index === 0 || message.dayKey !== chat.messages[index - 1].dayKey)
          @!component('components/day-separator', { label: message.dayLabel })
        @end
        @!component('components/message-bubble', { message })
      @end
    </div>

    {{-- ===== Zone de saisie ===== --}}
    <form id="composer" action="{{ route('groups.messages.store', { id: chat.id }) }}" method="POST" data-no-loader class="flex-none border-t border-line bg-surface p-3">

      <div id="edit-banner" class="mb-2 hidden items-center justify-between rounded-lg bg-primary-soft px-3 py-1.5 text-sm text-on-primary-soft">
        <span>Modification du message</span>
        <button type="button" data-cancel-edit aria-label="Annuler la modification" class="cursor-pointer px-1 font-bold">✕</button>
      </div>

      <div class="flex items-center gap-2">
        <input
          name="content"
          type="text"
          autocomplete="off"
          maxlength="2000"
          placeholder="Écrire un message au groupe…"
          class="min-w-0 flex-1 rounded-full border border-line-strong bg-surface px-4 py-2.5 text-fg placeholder:text-fg-subtle focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/30"
        >
        <button type="submit" aria-label="Envoyer" class="flex h-11 w-11 flex-none cursor-pointer items-center justify-center rounded-full bg-primary text-on-primary hover:bg-primary-hover disabled:cursor-not-allowed disabled:opacity-60">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <line x1="22" y1="2" x2="11" y2="13" />
            <polygon points="22 2 15 22 11 13 2 9 22 2" />
          </svg>
        </button>
      </div>
    </form>

    {{-- ===== Fenêtre : informations du groupe ===== --}}
    <dialog
      id="group-info-modal"
      aria-labelledby="group-info-title"
      class="m-auto max-h-[90dvh] w-[calc(100%-2rem)] max-w-md overflow-y-auto rounded-2xl border border-line bg-surface p-0 text-fg shadow-lg backdrop:bg-black/50"
    >
      <div class="p-6">

        <div class="flex items-start justify-between gap-4">
          <h2 id="group-info-title" class="text-xl font-bold text-fg">Informations du groupe</h2>
          <button type="button" data-modal-close aria-label="Fermer" class="cursor-pointer rounded-md p-1 text-fg-subtle hover:bg-surface-2 hover:text-fg">✕</button>
        </div>

        {{-- Identité du groupe --}}
        <div class="mt-4 flex items-center gap-4">
          @!component('components/user-avatar', { initials: chat.group.initials, tone: 'group' })
          <div class="min-w-0">
            <p class="truncate text-lg font-semibold text-fg">{{ chat.group.name }}</p>
            <p class="text-sm text-fg-muted">{{ chat.group.membersCount }} membres</p>
          </div>
        </div>

        <dl class="mt-4 space-y-3">
          @component('components/info-row', { label: 'Créé le', value: chat.group.createdAt })
            <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <rect x="3" y="4" width="18" height="18" rx="2" />
              <line x1="16" y1="2" x2="16" y2="6" />
              <line x1="8" y1="2" x2="8" y2="6" />
              <line x1="3" y1="10" x2="21" y2="10" />
            </svg>
          @end

          @component('components/info-row', { label: 'Créé par', value: chat.group.creatorName })
            <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
              <circle cx="12" cy="7" r="4" />
            </svg>
          @end
        </dl>

        {{-- Liste des membres --}}
        <h3 class="mt-6 text-sm font-semibold uppercase tracking-wide text-fg-subtle">Membres ({{ chat.group.membersCount }})</h3>
        <ul class="mt-2 divide-y divide-line rounded-xl border border-line">
          @each(member in chat.members)
            <li class="flex items-center gap-3 px-3 py-2.5">
              @!component('components/user-avatar', { initials: member.initials, src: member.avatarUrl, online: member.isOnline, showOffline: true, size: 'sm' })
              <span class="min-w-0 flex-1 truncate font-medium text-fg">
                {{ member.fullName }}
                @if(member.isMe)
                  <span class="font-normal text-fg-subtle">(vous)</span>
                @end
              </span>
              @if(member.isAdmin)
                <span class="flex-none rounded-full bg-group-soft px-2.5 py-0.5 text-xs font-semibold text-group">Admin</span>
              @end
            </li>
          @end
        </ul>

        {{-- Ajouter des membres : réservé à l'administrateur --}}
        @if(chat.group.isAdmin)
          <details class="mt-6 rounded-xl border border-line">
            <summary class="cursor-pointer px-4 py-3 font-semibold text-fg">Ajouter des membres</summary>

            <form data-add-members-form action="{{ route('groups.members.store', { id: chat.id }) }}" method="POST" data-no-loader class="space-y-4 border-t border-line p-4">
              @!component('components/member-picker', { candidates: chat.candidates })

              @if(chat.candidates.length > 0)
                <button type="submit" class="w-full cursor-pointer rounded-lg bg-primary px-4 py-2.5 font-semibold text-on-primary hover:bg-primary-hover disabled:cursor-not-allowed disabled:opacity-60">
                  Ajouter au groupe
                </button>
              @end
            </form>
          </details>
        @end

        <button type="button" data-modal-close class="mt-6 w-full cursor-pointer rounded-lg border border-line-strong px-4 py-2.5 font-semibold text-fg hover:bg-surface-2">
          Fermer
        </button>
      </div>
    </dialog>
  </div>
@else
  @include('partials/group-empty')
@end