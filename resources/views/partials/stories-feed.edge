{{-- ===== MES STORIES ===== --}}
<section class="rounded-2xl border border-line bg-surface p-5 shadow-sm">

  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h2 class="text-lg font-bold text-fg">Mes stories</h2>
      <p class="text-sm text-fg-muted">{{ limits.count }} / {{ limits.max }} stories actives</p>
    </div>

    @if(limits.canAdd)
      <button type="button" data-open-story-add class="inline-flex cursor-pointer items-center gap-2 rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-on-primary hover:bg-primary-hover">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" viewBox="0 0 24 24">
          <line x1="12" y1="5" x2="12" y2="19" />
          <line x1="5" y1="12" x2="19" y2="12" />
        </svg>
        Ajouter une story
      </button>
    @else
      {{-- Limite atteinte : on explique quand une place se libère --}}
      <p class="rounded-lg bg-warning-soft px-3 py-2 text-sm text-warning">
        Limite atteinte. Une place se libérera dans <strong>{{ limits.nextSlotIn }}</strong>.
      </p>
    @end
  </div>

  @if(myStories.length === 0)
    <p class="mt-4 text-sm text-fg-subtle">Vous n'avez aucune story active. Une story reste visible 24 h.</p>
  @else
    <div class="mt-4 flex gap-3 overflow-x-auto pb-2">
      @each(story in myStories)
        @!component('components/story-thumb', { story, author: { name: 'Vous', initials: me.initials, avatarUrl: me.avatarUrl } })
      @end
    </div>
  @end
</section>

{{-- ===== STORIES DES AUTRES UTILISATEURS ===== --}}
@if(authors.length === 0)
  <section class="rounded-2xl border border-line bg-surface px-6 py-12 text-center shadow-sm">
    <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-accent-soft text-on-accent-soft">
      <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="9" stroke-dasharray="4 3" />
        <circle cx="12" cy="12" r="4" />
      </svg>
    </span>
    <p class="mt-4 text-fg-muted">Personne n'a publié de story pour le moment.</p>
  </section>
@else
  @each(author in authors)
    <section class="rounded-2xl border border-line bg-surface p-5 shadow-sm">
      <div class="flex items-center gap-3">
        @!component('components/user-avatar', { initials: author.initials, src: author.avatarUrl, online: author.isOnline, showOffline: true, userId: author.id })
        <div class="min-w-0">
          <p class="truncate font-semibold text-fg">{{ author.fullName }}</p>
          <p class="text-xs text-fg-subtle">{{ author.stories.length }} {{ author.stories.length > 1 ? 'stories' : 'story' }}</p>
        </div>
      </div>

      <div class="mt-4 flex gap-3 overflow-x-auto pb-2">
        @each(story in author.stories)
          @!component('components/story-thumb', { story, author: { name: author.fullName, initials: author.initials, avatarUrl: author.avatarUrl } })
        @end
      </div>
    </section>
  @end
@end