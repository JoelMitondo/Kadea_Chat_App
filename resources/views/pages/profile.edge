@layouts.app({ title: 'Mon profil · Kadea Chat', active: 'profile' })

  {{-- Classes communes aux champs de la modale --}}
  @let(inputClasses = 'w-full rounded-lg border border-line-strong bg-surface px-3.5 py-2.5 text-fg placeholder:text-fg-subtle focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/30')

  <div class="mx-auto w-full max-w-4xl space-y-6 p-4 sm:p-6">

    {{-- ===== 1. EN-TÊTE DU PROFIL ===== --}}
    <section class="overflow-hidden rounded-2xl border border-line bg-surface shadow-sm">

      {{-- Bandeau sobre --}}
      <div class="h-24 bg-primary-soft sm:h-32"></div>

      <div class="px-5 pb-6 sm:px-8">
        <div class="-mt-12 flex flex-col gap-4 sm:-mt-14 sm:flex-row sm:items-end sm:justify-between">

          {{-- Avatar : les initiales sont dessous, la photo passe par-dessus.
               Si l'URL Cloudinary est cassée, onerror retire l'image et les initiales restent. --}}
          <div class="relative h-24 w-24 flex-none sm:h-28 sm:w-28">
            <span class="flex h-full w-full items-center justify-center rounded-full border-4 border-surface bg-surface-2 text-3xl font-bold text-on-primary-soft">
              {{ profile.initials }}
            </span>

            @if(profile.avatarUrl)
              <img
                src="{{ profile.avatarUrl }}"
                alt="Photo de {{ profile.fullName }}"
                onerror="this.remove()"
                class="absolute inset-0 h-full w-full rounded-full border-4 border-surface object-cover"
              >
            @end

            {{-- Puce "en ligne" qui pulse --}}
            <span class="absolute bottom-1 right-1 flex h-5 w-5" title="En ligne">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-online opacity-60"></span>
              <span class="relative inline-flex h-5 w-5 rounded-full border-2 border-surface bg-online"></span>
            </span>
          </div>

          {{-- Bouton qui ouvre la modale --}}
          <button
            type="button"
            data-modal-open="profile-modal"
            class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-lg bg-primary px-4 py-2.5 font-semibold text-on-primary hover:bg-primary-hover"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <path d="M12 20h9" />
              <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z" />
            </svg>
            Modifier le profil
          </button>
        </div>

        {{-- Nom, statut et bio --}}
        <div class="mt-4">
          <div class="flex flex-wrap items-center gap-3">
            <h1 class="text-2xl font-bold text-fg">{{ profile.fullName }}</h1>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-success-soft px-2.5 py-1 text-xs font-semibold text-success">
              <span class="h-2 w-2 animate-pulse rounded-full bg-online"></span>
              En ligne
            </span>
          </div>

          @if(profile.bio)
            <p class="mt-2 max-w-2xl whitespace-pre-line text-fg-muted">{{ profile.bio }}</p>
          @else
            <p class="mt-2 text-fg-subtle italic">Aucune bio pour le moment.</p>
          @end
        </div>
      </div>
    </section>

    {{-- ===== 2. STATISTIQUES D'ACTIVITÉ ===== --}}
    <section aria-label="Statistiques d'activité" class="grid gap-4 sm:grid-cols-3">

      @component('components/stat-card', { label: 'Conversations individuelles', value: stats.privateChats, tone: 'primary' })
        <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
        </svg>
      @end

      @component('components/stat-card', { label: 'Groupes', value: stats.groups, tone: 'group' })
        <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
          <circle cx="9" cy="7" r="4" />
          <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
          <path d="M16 3.13a4 4 0 0 1 0 7.75" />
        </svg>
      @end

      @component('components/stat-card', { label: 'Total des messages', value: stats.messages, tone: 'accent' })
        <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
          <line x1="22" y1="2" x2="11" y2="13" />
          <polygon points="22 2 15 22 11 13 2 9 22 2" />
        </svg>
      @end

    </section>

    {{-- ===== 3. INFORMATIONS DÉTAILLÉES ===== --}}
    <section class="rounded-2xl border border-line bg-surface p-5 shadow-sm sm:p-6">
      <h2 class="text-lg font-bold text-fg">Informations du compte</h2>

      <dl class="mt-4 grid gap-3 sm:grid-cols-2">

        @component('components/info-row', { label: 'Téléphone', value: profile.phoneNumber || 'Non renseigné' })
          <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
        @end

        @component('components/info-row', { label: 'Date de naissance', value: profile.birthDateLabel })
          <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="18" rx="2" />
            <line x1="16" y1="2" x2="16" y2="6" />
            <line x1="8" y1="2" x2="8" y2="6" />
            <line x1="3" y1="10" x2="21" y2="10" />
          </svg>
        @end

        @component('components/info-row', { label: "Mon e-mail", value: profile.email })
          <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <rect x="2" y="4" width="20" height="16" rx="2" />
            <path d="m22 7-10 6L2 7" />
          </svg>
        @end

        @component('components/info-row', { label: "Date d'inscription", value: profile.createdAt })
          <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
            <circle cx="8.5" cy="7" r="4" />
            <polyline points="17 11 19 13 23 9" />
          </svg>
        @end

      </dl>
    </section>
  </div>

  {{-- ===== MODALE : MODIFIER LE PROFIL ===== --}}
  <dialog
    id="profile-modal"
    aria-labelledby="profile-modal-title"
    class="m-auto max-h-[90dvh] w-[calc(100%-2rem)] max-w-lg overflow-y-auto rounded-2xl border border-line bg-surface p-0 text-fg shadow-lg backdrop:bg-black/50"
  >
    <form
      action="{{ route('profile.update') }}"
      method="POST"
      data-ajax
      data-no-reset
      data-success="Votre profil a été mis à jour."
      data-loading-text="Enregistrement…"
      data-redirect="/profile"
      class="space-y-5 p-6"
    >
      {{ csrfField() }}

      <div class="flex items-start justify-between gap-4">
        <h2 id="profile-modal-title" class="text-xl font-bold text-fg">Modifier le profil</h2>
        <button type="button" data-modal-close aria-label="Fermer" class="cursor-pointer rounded-md p-1 text-fg-subtle hover:bg-surface-2 hover:text-fg">✕</button>
      </div>

      <div>
        <label for="full_name" class="mb-1.5 block text-sm font-medium text-fg">Nom complet</label>
        <input id="full_name" name="full_name" type="text" required autocomplete="name" value="{{ profile.fullName }}" class="{{ inputClasses }}">
      </div>

      <div>
        <label for="bio" class="mb-1.5 block text-sm font-medium text-fg">Bio</label>
        <textarea id="bio" name="bio" rows="3" maxlength="500" placeholder="Parlez un peu de vous…" class="{{ inputClasses }}">{{ profile.bio }}</textarea>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="phone_number" class="mb-1.5 block text-sm font-medium text-fg">Téléphone</label>
          <input id="phone_number" name="phone_number" type="tel" autocomplete="tel" placeholder="+243 000 000 000" value="{{ profile.phoneNumber }}" class="{{ inputClasses }}">
        </div>

        <div>
          <label for="birth_date" class="mb-1.5 block text-sm font-medium text-fg">Date de naissance</label>
          <input id="birth_date" name="birth_date" type="date" required autocomplete="bday" value="{{ profile.birthDateInput }}" class="{{ inputClasses }}">
        </div>
      </div>

      <div>
        <label for="avatar_url" class="mb-1.5 block text-sm font-medium text-fg">Photo de profil (URL)</label>
        <input id="avatar_url" name="avatar_url" type="name" placeholder="https://res.cloudinary.com/..." value="{{ profile.avatarUrl }}" class="{{ inputClasses }}">
      </div>

      <div class="flex flex-col-reverse gap-3 pt-2 sm:flex-row sm:justify-end">
        <button type="button" data-modal-close class="cursor-pointer rounded-lg border border-line-strong px-4 py-2.5 font-semibold text-fg hover:bg-surface-2">
          Annuler
        </button>
        <button type="submit" class="cursor-pointer rounded-lg bg-primary px-4 py-2.5 font-semibold text-on-primary hover:bg-primary-hover disabled:cursor-not-allowed disabled:opacity-60">
          Enregistrer
        </button>
      </div>
    </form>
  </dialog>

  <script src="/resources/js/profile.js"></script>

@end