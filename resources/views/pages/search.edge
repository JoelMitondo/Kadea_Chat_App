@layouts.app({ title: 'Recherche · Kadea Chat', active: 'messages' })

  <div class="mx-auto w-full max-w-3xl p-4 sm:p-6">

    <h1 class="text-xl font-bold text-fg">Rechercher un message</h1>
    <p class="mt-1 text-sm text-fg-muted">La recherche porte sur vos conversations privées et vos groupes.</p>

    {{-- Champ de recherche --}}
    <form action="/search" method="GET" role="search" class="relative mt-4">
      <svg class="pointer-events-none absolute left-3 top-1/2 h-5 w-5 -translate-y-1/2 text-fg-subtle" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
        <circle cx="11" cy="11" r="8" />
        <line x1="21" y1="21" x2="16.65" y2="16.65" />
      </svg>
      <input
        type="search"
        name="q"
        value="{{ search }}"
        autocomplete="off"
        placeholder="Rechercher un mot…"
        aria-label="Rechercher un mot dans vos messages"
        class="w-full rounded-full border border-line bg-surface py-2.5 pl-10 pr-4 text-fg placeholder:text-fg-subtle focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/30"
      >
    </form>

    {{-- Résultats --}}
    <div class="mt-6">
      @if(!hasSearched)

        <p class="text-center text-sm text-fg-subtle">Tapez au moins 2 caractères, puis appuyez sur Entrée.</p>

      @elseif(results.length === 0)

        <div class="rounded-2xl border border-line bg-surface px-6 py-12 text-center shadow-sm">
          <p class="text-fg-muted">Aucun message ne contient « {{ search }} ».</p>
        </div>

      @else

        <p class="mb-3 text-sm text-fg-muted">
          {{ results.length }} résultat{{ results.length > 1 ? 's' : '' }} pour « {{ search }} »
        </p>

        <ul class="space-y-3">
          @each(result in results)
            <li>
              {{-- Un clic ouvre la conversation qui contient le message --}}
              <a href="{{ result.url }}" class="block rounded-xl border border-line bg-surface p-4 shadow-sm hover:bg-surface-2">
                <div class="flex items-center justify-between gap-3">
                  <span class="flex min-w-0 items-center gap-2">
                    <span class="truncate font-semibold text-fg">{{ result.conversationName }}</span>
                    @if(result.isGroup)
                      <span class="flex-none rounded-full bg-group-soft px-2 py-0.5 text-xs font-semibold text-group">Groupe</span>
                    @end
                  </span>
                  <span class="flex-none text-xs text-fg-subtle">{{ result.when }}</span>
                </div>

                <p class="mt-1.5 text-sm text-fg-muted">
                  <span class="font-medium text-fg">{{ result.senderName }} :</span>
                  {{ result.before }}<mark class="rounded bg-warning-soft px-0.5 font-semibold text-warning">{{ result.match }}</mark>{{ result.after }}
                </p>
              </a>
            </li>
          @end
        </ul>

      @end
    </div>
  </div>

@end