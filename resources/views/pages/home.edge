{{-- vérification si l'utilisateur est connecté --}}
@let(isLoggedIn = auth.isAuthenticated)

@layouts.landing({ title: 'Kadea Chat · Discutez simplement, en privé ou en groupe', isLoggedIn: isLoggedIn })

  {{-- hero section --}}
  <section class="relative isolate overflow-hidden">

    <div class="mx-auto grid max-w-6xl items-center gap-14 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:py-24">

      {{-- Texte --}}
      <div class="kc-apparition">
        <span class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1 text-sm font-medium text-fg-muted">
