{{--
  Page d'erreur unique de Kadea Chat (404, 403, 500, lien invalide ou expiré...).
  Les textes sont préparés côté serveur dans app/service/error_page.ts.
--}}
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>{{ page.title }} · Kadea Chat</title>
  <meta name="theme-color" content="#2563eb">
  <link rel="icon" href="https://i.ibb.co/1YhrGKHz/logo-Kadea.png" type="image/png">

  {{-- Thème clair ou sombre appliqué avant l'affichage --}}
  <script>
    try {
      let themeSauvegarde = localStorage.getItem('theme')
      let themeDuSysteme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
      document.documentElement.dataset.theme = themeSauvegarde || themeDuSysteme
    } catch (erreur) {}
  </script>

  @vite(['resources/css/compiles/app.css'])
</head>

<body class="flex min-h-screen flex-col bg-canvas text-fg antialiased">

  <header class="border-b border-line bg-surface">
    <div class="mx-auto flex h-16 max-w-6xl items-center px-4 sm:px-6">
      <a href="/" class="flex items-center gap-2.5" aria-label="Retour à l'accueil de Kadea Chat">
        <img src="https://i.ibb.co/MxSRtHyW/logo-Kadea.png" alt="Logo Kadea Chat" class="h-9 w-9">
        <span class="text-xl font-bold">
          <span class="text-navy-800 dark:text-white">Kadea</span>
          <span class="text-azure-500">Chat</span>
        </span>
      </a>
    </div>
  </header>

  <main class="flex flex-1 items-center justify-center px-4 py-12">
    <div class="w-full max-w-lg text-center">

      {{-- Code de l'erreur, en grand et en léger --}}
      <p aria-hidden="true" class="select-none text-7xl font-extrabold tracking-tight text-azure-500/20 sm:text-8xl">
        {{ page.code }}
      </p>

      <div class="-mt-6 rounded-2xl border border-line bg-surface p-6 shadow-sm sm:-mt-8 sm:p-8">

        {{-- Pastille avec une icône selon le type d'erreur --}}
        <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full {{ page.tone === 'danger' ? 'bg-danger-soft text-danger' : (page.tone === 'warning' ? 'bg-warning-soft text-warning' : 'bg-primary-soft text-on-primary-soft') }}">
          @if(page.icon === 'link')
            <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
              <line x1="4" y1="4" x2="20" y2="20" />
            </svg>
          @elseif(page.icon === 'clock')
            <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="10" />
              <polyline points="12 6 12 12 16 14" />
            </svg>
          @elseif(page.icon === 'lock')
            <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="11" width="18" height="11" rx="2" />
              <path d="M7 11V7a5 5 0 0 1 10 0v4" />
            </svg>
          @elseif(page.icon === 'server')
            <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
              <line x1="12" y1="9" x2="12" y2="13" />
              <line x1="12" y1="17" x2="12.01" y2="17" />
            </svg>
          @else
            <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="11" cy="11" r="8" />
              <line x1="21" y1="21" x2="16.65" y2="16.65" />
              <line x1="8" y1="11" x2="14" y2="11" />
            </svg>
          @end
        </span>

        <h1 class="mt-5 text-2xl font-bold text-fg">{{ page.title }}</h1>
        <p class="mt-2 text-fg-muted">{{ page.message }}</p>

        @if(page.hint)
          <p class="mt-4 rounded-lg bg-surface-2 px-4 py-3 text-sm text-fg-muted">{{ page.hint }}</p>
        @end

        {{-- Actions proposées --}}
        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-center">
          @each(action in page.actions)
            <a
              href="{{ action.href }}"
              class="{{ action.primary ? 'bg-primary text-on-primary hover:bg-primary-hover' : 'border border-line-strong text-fg hover:bg-surface-2' }} inline-flex items-center justify-center rounded-lg px-5 py-2.5 font-semibold"
            >
              {{ action.label }}
            </a>
          @end
        </div>
      </div>

      {{-- Référence utile pour signaler un problème --}}
      @if(page.reference)
        <p class="mt-4 text-xs text-fg-subtle">Référence de l'erreur : {{ page.reference }}</p>
      @end
    </div>
  </main>

  <footer class="py-6 text-center text-sm text-fg-subtle">
    © 2026 Kadea Chat · NMS Tech
  </footer>
</body>
</html>
