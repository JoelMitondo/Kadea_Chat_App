@layouts.auth({ title: 'Finalisation · Kadea Chat' })
  @slot('main')

    <div class="grid w-full max-w-5xl items-center gap-12 lg:grid-cols-2">

      {{-- Présentation (cachée sur téléphone) --}}
      <div class="hidden lg:block">
        <p class="text-sm font-semibold uppercase tracking-wide text-link">Kadea Academy</p>
        <h1 class="mt-3 text-4xl font-bold leading-tight text-fg">
          Finalisez la création de votre compte.
        </h1>
        <p class="mt-4 text-lg text-fg-muted">
          Votre adresse e-mail a été vérifiée. Complétez vos informations pour accéder à vos conversations.
        </p>

        <ul class="mt-8 space-y-4 text-fg-muted">
          <li class="flex items-center gap-3">
            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-primary-soft text-sm font-bold text-on-primary-soft">✓</span>
            Messages reçus instantanément
          </li>
          <li class="flex items-center gap-3">
            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-primary-soft text-sm font-bold text-on-primary-soft">✓</span>
            Conversations privées et groupes
          </li>
          <li class="flex items-center gap-3">
            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-primary-soft text-sm font-bold text-on-primary-soft">✓</span>
            Historique conservé à chaque connexion
          </li>
        </ul>
      </div>

      {{-- Le formulaire --}}
      <div class="w-full rounded-2xl border border-line bg-surface p-6 shadow-sm sm:p-8">

        <h2 class="text-2xl font-bold text-fg">Finaliser mon compte</h2>
        <p class="mt-1 text-sm text-fg-muted">Vérifiez vos informations et définissez vos identifiants.</p>

        <form id="completeProfileForm" action="/signup/{{ id }}/{{ code }}" method="POST" class="mt-6 space-y-5">

          {{-- Protection de sécurité --}}
          {{ csrfField() }}

          {{-- BLOC : Informations pré-remplies (Lecture seule) --}}
          <div class="space-y-4 rounded-xl border border-line-strong bg-surface-subtle p-4">
            <div class="flex items-center justify-between border-b border-line pb-2">
              <span class="text-xs font-semibold uppercase tracking-wider text-fg-muted">Informations vérifiées</span>
              <span class="rounded bg-warning-soft px-2 py-0.5 text-xs font-medium text-on-warning-soft">
                Ce champ ne peut pas être modifié
              </span>
            </div>

            {{-- Nom complet --}}
            <div>
              @field.root({ name: 'full_name' })
                @field.label({ class: 'mb-1 block text-xs font-medium text-fg-muted' })
                  Nom complet
                @end

                @!input.control({
                  id: 'full_name',
                  type: 'text',
                  value: user.full_name,
                  readonly: true,
                  class: 'w-full cursor-not-allowed rounded-lg border border-line bg-surface-disabled px-3.5 py-2 text-sm text-fg-muted select-none focus:outline-none'
                })
              @end
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
              {{-- Date de naissance --}}
              <div>
                @field.root({ name: 'birth_date' })
                  @field.label({ class: 'mb-1 block text-xs font-medium text-fg-muted' })
                    Date de naissance
                  @end

                  @!input.control({
                    id: 'birth_date',
                    type: 'text',
                    value: user.birth_date,
                    readonly: true,
                    class: 'w-full cursor-not-allowed rounded-lg border border-line bg-surface-disabled px-3.5 py-2 text-sm text-fg-muted select-none focus:outline-none'
                  })
                @end
              </div>

              {{-- Adresse e-mail --}}
              <div>
                @field.root({ name: 'email' })
                  @field.label({ class: 'mb-1 block text-xs font-medium text-fg-muted' })
                    Adresse e-mail
                  @end

                  @!input.control({
                    id: 'email',
                    type: 'email',
                    value: user.email,
                    readonly: true,
                    class: 'w-full cursor-not-allowed rounded-lg border border-line bg-surface-disabled px-3.5 py-2 text-sm text-fg-muted select-none focus:outline-none'
                  })
                @end
              </div>
            </div>
          </div>

          {{-- Informations à remplir --}}
          <div class="space-y-5 pt-2">

            {{-- Mot de passe --}}
            <div>
              @field.root({ name: 'password' })
                @field.label({ class: 'mb-1.5 block text-sm font-medium text-fg' })
                  Mot de passe
                @end

                @!input.control({
                  id: 'password',
                  type: 'password',
                  autocomplete: 'new-password',
                  required: true,
                  placeholder: '••••••••',
                  class: 'w-full rounded-lg border border-line-strong bg-surface px-3.5 py-2.5 text-fg placeholder:text-fg-subtle focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/30'
                })

                @!field.error({ class: 'mt-1.5 text-sm text-danger' })
              @end
            </div>

            {{-- Numéro de téléphone --}}
            <div>
              @field.root({ name: 'phone_number' })
                @field.label({ class: 'mb-1.5 block text-sm font-medium text-fg' })
                  Numéro de téléphone
                @end

                @!input.control({
                  id: 'phone_number',
                  type: 'tel',
                  autocomplete: 'tel',
                  placeholder: '+243 000 000 000',
                  class: 'w-full rounded-lg border border-line-strong bg-surface px-3.5 py-2.5 text-fg placeholder:text-fg-subtle focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/30'
                })

                @!field.error({ class: 'mt-1.5 text-sm text-danger' })
              @end
            </div>

          </div>

          {{-- Bouton d'envoi --}}
          <button
            type="submit"
            class="w-full cursor-pointer rounded-lg bg-primary px-4 py-3 font-semibold text-on-primary hover:bg-primary-hover transition-colors"
          >
            Créer mon compte
          </button>

        </form>

        {{-- Lien vers la connexion --}}
        <p class="mt-6 text-center text-sm text-fg-muted">
          Vous avez déjà un compte ?
          <a href="/login" class="font-medium text-link hover:underline">Se connecter</a>
        </p>

      </div>
    </div>

  @end
@end