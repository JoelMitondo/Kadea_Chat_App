@layouts.auth({ title: 'Connexion · Kadea Chat' })

  {{-- Carte centrée, même style que la page d'inscription --}}
  <div class="w-full max-w-md rounded-2xl border border-line bg-surface p-6 shadow-sm sm:p-8">

    {{-- Titre --}}
    <h1 class="text-2xl font-bold text-fg">Bon retour parmi nous</h1>
    <p class="mt-1 text-fg-muted">Connectez-vous pour retrouver vos conversations.</p>

    @form({
      route: 'session.store',
      method: 'POST',
      class: 'mt-6 space-y-5',
      'x-data': '{ submitting: false }',
      'x-on:submit': 'submitting = true',
    })

      {{-- Adresse e-mail --}}
      @field.root({ name: 'email' })
        @!field.label({
          class: 'mb-1.5 block text-sm font-medium text-fg',
          text: 'Adresse e-mail'
        })
        @!input.control({
          type: 'email',
          autocomplete: 'username',
          placeholder: 'nom@exemple.com',
          class: 'w-full rounded-lg border border-line-strong bg-surface px-3.5 py-2.5 text-fg placeholder:text-fg-subtle focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/30'
        })
        @!field.error({ class: 'mt-1.5 text-sm text-danger' })
      @end

      {{-- Mot de passe --}}
      @field.root({ name: 'password' })

        {{-- Le libellé à gauche, le lien "Mot de passe oublié" à droite --}}
        <div class="mb-1.5 flex items-center justify-between">
          @!field.label({
            class: 'block text-sm font-medium text-fg',
            text: 'Mot de passe'
          })
          <a href="{{ route('forgotPassword.get') }}" class="text-sm font-medium text-link hover:underline">
            Mot de passe oublié ?
          </a>
        </div>

        @!input.control({
          type: 'password',
          autocomplete: 'current-password',
          placeholder: '••••••••',
          class: 'w-full rounded-lg border border-line-strong bg-surface px-3.5 py-2.5 text-fg placeholder:text-fg-subtle focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/30'
        })
        @!field.error({ class: 'mt-1.5 text-sm text-danger' })
      @end

      {{-- Bouton avec changement (Alpine) --}}
      <button
        type="submit"
        x-bind:disabled="submitting"
        x-text="submitting ? 'Connexion en cours…' : 'Se connecter'"
        class="w-full cursor-pointer rounded-lg bg-primary px-4 py-3 font-semibold text-on-primary hover:bg-primary-hover disabled:cursor-not-allowed disabled:opacity-60"
      >
        Se connecter
      </button>

    @end

    {{-- Lien vers l'inscription --}}
    <p class="mt-6 text-center text-sm text-fg-muted">
      Pas encore de compte ?
      @link({ route: 'New_compte.register', class: 'font-medium text-link hover:underline' })
        Créer un compte
      @end
    </p>

  </div>

@end