@layouts.auth({ title: 'Nouveau mot de passe · Kadea Chat' })

  <div class="w-full max-w-md rounded-2xl border border-line bg-surface p-6 shadow-sm sm:p-8">

    @if(lienValide)

      {{-- CAS 1 : le lien est valide, on affiche le formulaire --}}
      <h1 class="text-2xl font-bold text-fg">Nouveau mot de passe</h1>
      <p class="mt-2 text-fg-muted">Choisissez un nouveau mot de passe pour votre compte Kadea Chat.</p>

      <form
        action="{{ route('forgot_password.reset', { id: id, code: code }) }}"
        method="POST"
        data-ajax
        data-success="Votre mot de passe a été modifié. Vous allez être redirigé vers vos messages."
        data-loading-text="Enregistrement…"
        data-redirect="/messages"
        class="mt-6 space-y-5"
      >

        {{ csrfField() }}


        {{-- Nouveau mot de passe --}}
        <div>
          <label for="password" class="mb-1.5 block text-sm font-medium text-fg">Nouveau mot de passe</label>
          <input
            id="password"
            name="password"
            type="password"
            autocomplete="new-password"
            minlength="8"
            required
            class="w-full rounded-lg border border-line-strong bg-surface px-3.5 py-2.5 text-fg placeholder:text-fg-subtle focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/30"
          >
          <p class="mt-1.5 text-sm text-fg-subtle">8 caractères minimum.</p>
        </div>

        {{-- Confirmation --}}
        <div>
          <label for="password_confirmation" class="mb-1.5 block text-sm font-medium text-fg">Confirmer le mot de passe</label>
          <input
            id="password_confirmation"
            name="password_confirmation"
            type="password"
            autocomplete="new-password"
            minlength="8"
            required
            class="w-full rounded-lg border border-line-strong bg-surface px-3.5 py-2.5 text-fg placeholder:text-fg-subtle focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/30"
          >
        </div>

        <button
          type="submit"
          class="w-full cursor-pointer rounded-lg bg-primary px-4 py-3 font-semibold text-on-primary hover:bg-primary-hover disabled:cursor-not-allowed disabled:opacity-60"
        >
          Enregistrer le mot de passe
        </button>

      </form>

    @else

      {{-- CAS 2 : lien invalide ou expiré --}}
      <div class="text-center">
        <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-danger-soft text-xl font-bold text-danger">✕</span>
        <h1 class="mt-4 text-2xl font-bold text-fg">Lien invalide ou expiré</h1>
        <p class="mt-2 text-fg-muted">
          Ce lien de réinitialisation n'est plus valable. Faites une nouvelle demande pour en recevoir un autre.
        </p>
        <a
          href="{{ route('forgotPassword.get') }}"
          class="mt-6 inline-block w-full rounded-lg bg-primary px-4 py-3 font-semibold text-on-primary hover:bg-primary-hover"
        >
          Refaire une demande
        </a>
      </div>

    @end

    <p class="mt-6 text-center text-sm">
      <a href="/login" class="font-medium text-link hover:underline">← Retour à la connexion</a>
    </p>

  </div>

@end