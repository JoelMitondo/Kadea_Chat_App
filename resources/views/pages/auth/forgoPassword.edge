@layouts.auth({ title: 'Mot de passe oublié · AGORA' })

  <div class="w-full max-w-md rounded-2xl border border-line bg-surface p-6 shadow-sm sm:p-8">

    {{-- Titre et explication --}}
    <h1 class="text-2xl font-bold text-fg">Mot de passe oublié ?</h1>
    <p class="mt-2 text-fg-muted">
      Saisissez l'adresse e-mail de votre compte AGORA. Nous vous enverrons un lien
      pour choisir un nouveau mot de passe.
    </p>

    {{--
      data-ajax            : envoi sans quitter la page (script notifications.js)
      data-success         : le message affiché quand tout s'est bien passé
      data-loading-text    : le texte du bouton pendant l'envoi
    --}}
    <form
      action="/forgot-password"
      method="POST"
      data-ajax
      data-success="Si cette adresse correspond à un compte, un e-mail de réinitialisation vient de vous être envoyé."
      data-loading-text="Envoi en cours…"
      class="mt-6 space-y-5"
    >

      {{-- Protection de sécurité obligatoire pour les formulaires --}}
      {{ csrfField() }}

      {{-- Adresse e-mail --}}
      <div>
        <label for="email" class="mb-1.5 block text-sm font-medium text-fg">Adresse e-mail</label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          placeholder="nom@exemple.com"
          required
          value="{{ flashMessages.get('email') }}"
          class="w-full rounded-lg border border-line-strong bg-surface px-3.5 py-2.5 text-fg placeholder:text-fg-subtle focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/30"
        >
        @inputError('email')
          @each(message in $messages)
            <p class="mt-1.5 text-sm text-danger">{{ message }}</p>
          @end
        @end
      </div>

      {{-- Bouton d'envoi --}}
      <button
        type="submit"
        class="w-full cursor-pointer rounded-lg bg-primary px-4 py-3 font-semibold text-on-primary hover:bg-primary-hover disabled:cursor-not-allowed disabled:opacity-60"
      >
        Envoyer le lien
      </button>

    </form>

    {{-- Retour à la connexion --}}
    <p class="mt-6 text-center text-sm">
      <a href="/login" class="font-medium text-link hover:underline">← Retour à la connexion</a>
    </p>

  </div>

@end