@layouts.auth({ title: 'Créer un compte · Kadea Chat' })
  @slot('main')

    <div class="grid w-full max-w-5xl items-center gap-12 lg:grid-cols-2">

      {{-- présentation (cache téléphone) --}}
      <div class="hidden lg:block">
        <p class="text-sm font-semibold uppercase tracking-wide text-link">Kadea Chat</p>
        <h1 class="mt-3 text-4xl font-bold leading-tight text-fg">
          Discutez simplement, en privé ou en groupe.
        </h1>
        <p class="mt-4 text-lg text-fg-muted">
          Créez votre compte en une minute et retrouvez vos conversations partout.
        </p>

        <ul class="mt-8 space-y-4 text-fg-muted">
          <li class="flex items-center gap-3">
            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-primary-soft text-sm font-bold text-on-primary-soft">✓</span>
            Messages reçus instantanément
          </li>
          <li class="flex items-center gap-3">
            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-primary-soft text-sm font-bold text-on-primary-soft">✓</span>
            Conversations privées et groupes
          </li>
          <li class="flex items-center gap-3">
            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-primary-soft text-sm font-bold text-on-primary-soft">✓</span>
            Historique conservé à chaque connexion
          </li>
        </ul>
      </div>

      {{-- le formulaire --}}
      <div class="w-full rounded-2xl border border-line bg-surface p-6 shadow-sm sm:p-8">

        <h2 class="text-2xl font-bold text-fg">Créer un compte</h2>
        <p class="mt-1 text-fg-muted">Remplissez les champs ci-dessous.</p>

        <form id="registerForm" 
        action="/register" 
        method="POST"   
        data-ajax
        data-success="Votre compte a été créé. Un e-mail de confirmation vient de vous être envoyé."
        data-loading-text="Création du compte…"
        class="mt-6 space-y-5" class="mt-6 space-y-5">

          {{-- Protection de sécurité --}}
          {{ csrfField() }}

          {{-- Prénom et Nom  --}}
          <div class="grid gap-5 sm:grid-cols-2">

            <div>
              @field.root({ name: 'first_name' })
                @field.label({ class: 'mb-1.5 block text-sm font-medium text-fg' })
                  Prénom
                @end

                @!input.control({
                  id: 'first_name',
                  type: 'text',
                  autocomplete: 'given-name',
                  required: true,
                  placeholder: 'Joel',
                  class: 'w-full rounded-lg border border-line-strong bg-surface px-3.5 py-2.5 text-fg placeholder:text-fg-subtle focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/30'
                })

                @!field.error({ class: 'mt-1.5 text-sm text-danger' })
              @end
            </div>

            <div>
              @field.root({ name: 'last_name' })
                @field.label({ class: 'mb-1.5 block text-sm font-medium text-fg' })
                  Nom
                @end

                @!input.control({
                  id: 'last_name',
                  type: 'text',
                  autocomplete: 'family-name',
                  required: true,
                  placeholder: 'Mitondo',
                  class: 'w-full rounded-lg border border-line-strong bg-surface px-3.5 py-2.5 text-fg placeholder:text-fg-subtle focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/30'
                })

                @!field.error({ class: 'mt-1.5 text-sm text-danger' })
              @end
            </div>

          </div>

          {{-- Adresse e-mail --}}
          <div>
            @field.root({ name: 'email' })
              @!field.label({ 
                class: 'mb-1.5 block text-sm font-medium text-fg', 
                text: 'Adresse e-mail' 
              })

              @!input.control({
                id: 'email',
                type: 'email',
                autocomplete: 'email',
                placeholder: 'nom@exemple.com',
                required: true,
                class: 'w-full rounded-lg border border-line-strong bg-surface px-3.5 py-2.5 text-fg placeholder:text-fg-subtle focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/30'
              })

              @!field.error({ class: 'mt-1.5 text-sm text-danger' })
            @end
          </div>

          {{-- Confirmation de l'adresse e-mail --}}
          <div>
            @field.root({ name: 'email_confirmation' })
              @!field.label({ 
                class: 'mb-1.5 block text-sm font-medium text-fg', 
                text: "Confirmer l'adresse e-mail" 
              })

              @!input.control({
                id: 'email_confirmation',
                type: 'email',
                autocomplete: 'off',
                required: true,
                class: 'w-full rounded-lg border border-line-strong bg-surface px-3.5 py-2.5 text-fg placeholder:text-fg-subtle focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/30'
              })

              @!field.error({ class: 'mt-1.5 text-sm text-danger' })
            @end
          </div>

          {{-- Date de naissance --}}
          <div>
            @field.root({ name: 'birth_date' })
              @!field.label({ 
                class: 'mb-1.5 block text-sm font-medium text-fg', 
                text: 'Date de naissance' 
              })

              @!input.control({
                id: 'birth_date',
                type: 'date',
                autocomplete: 'bday',
                required: true,
                class: 'w-full rounded-lg border border-line-strong bg-surface px-3.5 py-2.5 text-fg focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/30'
              })

              @!field.error({ class: 'mt-1.5 text-sm text-danger' })
            @end
          </div>

          {{-- Bouton d'envoi --}}
          <button
            id="btnSumitInscription"
            type="submit"
            class="hidden w-full cursor-pointer rounded-lg bg-primary px-4 py-3 font-semibold text-on-primary hover:bg-primary-hover disabled:cursor-not-allowed disabled:opacity-60">                
            Créer mon compte
          </button>

        </form>

        {{-- Lien vers la connexion --}}
        <p class="mt-6 text-center text-sm text-fg-muted">
          Vous avez déjà un compte ?
          <a href="/login" class="font-medium text-link hover:underline">Se connecter</a>
        </p>

      </div>
    </div>

  @end
@end