    {{-- Recherche : fonctionne en direct avec le JavaScript, et par la touche Entrée sans lui --}}
    <form id="users-search-form" action="/users" method="GET" role="search" data-no-loader class="relative mb-4">
      <svg class="pointer-events-none absolute left-3 top-1/2 h-5 w-5 -translate-y-1/2 text-fg-subtle" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
        <circle cx="11" cy="11" r="8" />
        <line x1="21" y1="21" x2="16.65" y2="16.65" />
      </svg>
      <input
        id="users-search"
        name="q"
        type="search"
        value="{{ search }}"
        autocomplete="off"
        placeholder="Rechercher un utilisateur…"
        aria-label="Rechercher un utilisateur"
        class="w-full rounded-full border border-line bg-surface py-2.5 pl-10 pr-4 text-fg placeholder:text-fg-subtle focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/30"
      >
    </form>

    {{-- Résultats, ce bloc est remplacé à chaque recherche --}}
