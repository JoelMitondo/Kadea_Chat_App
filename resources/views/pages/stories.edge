@layouts.app({ title: 'Stories · Kadea Chat', active: 'stories' })

  <div id="stories-page" class="mx-auto w-full max-w-4xl space-y-6 p-4 sm:p-6">

    <div>
      <h1 class="text-xl font-bold text-fg">Stories</h1>
      <p class="mt-1 text-sm text-fg-muted">
        Une story reste visible 24 h. Pour économiser vos données, vous ne voyez qu'un aperçu flou :
        touchez une story pour la télécharger en qualité normale.
      </p>
    </div>

    {{-- Ce bloc est remplacé quand la liste change (nouvelle story, story expirée) --}}
    <div id="stories-feed" class="space-y-6">
      @include('partials/stories-feed')
    </div>
  </div>

  {{-- ==========================================================
       FENÊTRE : AJOUTER UNE STORY
       ========================================================== --}}
  <dialog
    id="story-add-modal"
    aria-labelledby="story-add-title"
    class="m-auto max-h-[90dvh] w-[calc(100%-2rem)] max-w-md overflow-y-auto rounded-2xl border border-line bg-surface p-0 text-fg shadow-lg backdrop:bg-black/50"
  >
    {{-- data-ajax : envoi sans quitter la page (notifications.js), comme le formulaire du profil --}}
    <form
      action="{{ route('stories.store') }}"
      method="POST"
      enctype="multipart/form-data"
      data-ajax
      data-success="Votre story est publiée. Elle restera visible pendant 24 h."
      data-loading-text="Publication…"
      data-redirect="/stories"
      class="space-y-5 p-6"
    >
      {{ csrfField() }}

      <div class="flex items-start justify-between gap-4">
        <h2 id="story-add-title" class="text-xl font-bold text-fg">Ajouter une story</h2>
        <button type="button" data-modal-close aria-label="Fermer" class="cursor-pointer rounded-md p-1 text-fg-subtle hover:bg-surface-2 hover:text-fg">✕</button>
      </div>

      {{-- Aperçu de l'image choisie --}}
      <div class="mx-auto flex aspect-[9/16] w-32 items-center justify-center overflow-hidden rounded-xl border border-dashed border-line-strong bg-surface-2">
        <img id="story-preview" alt="" class="hidden h-full w-full object-cover">
        <span id="story-preview-placeholder" class="px-2 text-center text-xs text-fg-subtle">Aperçu de votre story</span>
      </div>

      <div>
        <label for="story-image" class="mb-1.5 block text-sm font-medium text-fg">Image</label>
        {{-- Les erreurs du serveur s'affichent sous ce champ --}}
        <div>
          <input
            id="story-image"
            name="image"
            type="file"
            required
            accept="image/jpeg,image/png,image/webp"
            class="block w-full text-sm text-fg-muted file:mr-3 file:cursor-pointer file:rounded-lg file:border-0 file:bg-primary-soft file:px-4 file:py-2 file:font-semibold file:text-on-primary-soft"
          >
        </div>
        <p class="mt-1.5 text-xs text-fg-subtle">JPG, PNG ou WebP, 8 Mo maximum.</p>
      </div>

      <div>
        <label for="story-caption" class="mb-1.5 block text-sm font-medium text-fg">Légende (facultative)</label>
        <textarea
          id="story-caption"
          name="caption"
          rows="2"
          maxlength="150"
          placeholder="Ajoutez quelques mots…"
          class="w-full rounded-lg border border-line-strong bg-surface px-3.5 py-2.5 text-fg placeholder:text-fg-subtle focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/30"
        ></textarea>
      </div>

      <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
        <button type="button" data-modal-close class="cursor-pointer rounded-lg border border-line-strong px-4 py-2.5 font-semibold text-fg hover:bg-surface-2">
          Annuler
        </button>
        <button type="submit" class="cursor-pointer rounded-lg bg-primary px-4 py-2.5 font-semibold text-on-primary hover:bg-primary-hover disabled:cursor-not-allowed disabled:opacity-60">
          Publier
        </button>
      </div>
    </form>
  </dialog>

  {{-- VISIONNEUSE : s'ouvre au clic sur une story --}}
  <dialog
    id="story-viewer"
    aria-label="Visionneuse de story"
    class="m-0 h-dvh max-h-none w-screen max-w-none bg-black p-0 text-white backdrop:bg-black"
  >
    <div class="relative flex h-full w-full flex-col">

      {{-- Barre du haut : auteur, compteur, fermer --}}
      <div class="relative z-10 flex flex-none items-center gap-3 bg-black/60 px-4 py-3">
        <span class="relative flex h-10 w-10 flex-none">
          <span id="story-viewer-initials" class="flex h-full w-full items-center justify-center rounded-full bg-white/20 font-semibold"></span>
          <img id="story-viewer-avatar" alt="" class="absolute inset-0 hidden h-full w-full rounded-full object-cover">
        </span>

        <div class="min-w-0 flex-1">
          <p id="story-viewer-author" class="truncate font-semibold"></p>
          <p id="story-viewer-meta" class="truncate text-xs text-white/70"></p>
        </div>

        <span id="story-viewer-counter" class="flex-none text-xs text-white/70"></span>

        <button type="button" data-story-close aria-label="Fermer" class="flex h-9 w-9 flex-none cursor-pointer items-center justify-center rounded-full hover:bg-white/10">✕</button>
      </div>

      {{-- L'image --}}
      <div class="relative min-h-0 flex-1 overflow-hidden">

        {{-- Fond : l'aperçu flou --}}
        <img id="story-viewer-blur" alt="" class="absolute inset-0 h-full w-full scale-110 object-cover opacity-80">

        {{-- Version nette : son téléchargement ne commence qu'à l'ouverture de la visionneuse --}}
        <img id="story-viewer-image" alt="" class="absolute inset-0 h-full w-full object-contain opacity-0 transition-opacity duration-300">

        {{-- Chargement en cours --}}
        <div id="story-viewer-loading" class="absolute inset-0 flex flex-col items-center justify-center gap-3 bg-black/30">
          <span class="h-9 w-9 animate-spin rounded-full border-4 border-white/30 border-t-white"></span>
          <span class="text-sm">Téléchargement de la story…</span>
        </div>

        {{-- Erreur --}}
        <div id="story-viewer-error" class="absolute inset-0 hidden items-center justify-center bg-black/60 p-6 text-center text-sm">
          Impossible de charger cette story. Vérifiez votre connexion, puis réessayez.
        </div>

        {{-- Précédente / suivante --}}
        <button type="button" data-story-prev aria-label="Story précédente" class="absolute left-2 top-1/2 flex h-11 w-11 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full bg-black/50 hover:bg-black/70">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6" /></svg>
        </button>
        <button type="button" data-story-next aria-label="Story suivante" class="absolute right-2 top-1/2 flex h-11 w-11 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full bg-black/50 hover:bg-black/70">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6" /></svg>
        </button>
      </div>

      {{-- Légende --}}
      <p id="story-viewer-caption" class="hidden flex-none bg-black/60 px-4 py-3 text-center text-sm"></p>
    </div>
  </dialog>

  @vite(['resources/js/stories.js'])

@end