@layouts.app({ title: 'Messages · Kadea Chat', active: 'messages' })

  <div class="flex h-full">

    {{-- ===== Liste des conversations ===== --}}
    <section class="flex w-full flex-col border-r border-line bg-surface md:w-80 md:flex-none lg:w-96">

      <div class="flex items-center justify-between px-5 py-4">
        <h1 class="text-xl font-bold text-fg">Messages</h1>
        <a href="/users" title="Nouvelle conversation" aria-label="Nouvelle conversation" class="flex h-9 w-9 items-center justify-center rounded-full bg-primary text-on-primary hover:bg-primary-hover">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" viewBox="0 0 24 24">
            <line x1="12" y1="5" x2="12" y2="19" />
            <line x1="5" y1="12" x2="19" y2="12" />
          </svg>
        </a>
      </div>

      <div class="flex-1 overflow-y-auto">

        {{-- Conversation avec des messages non lus --}}
        <a href="#" class="flex items-center gap-3 border-l-4 border-primary bg-primary-soft px-4 py-3">
          <span class="relative flex h-12 w-12 flex-none items-center justify-center rounded-full bg-surface font-semibold text-on-primary-soft">
            AK
            <span class="absolute bottom-0 right-0 h-3 w-3 rounded-full border-2 border-surface bg-online"></span>
          </span>
          <span class="min-w-0 flex-1">
            <span class="flex items-center justify-between gap-2">
              <span class="truncate font-semibold text-fg">Amina K.</span>
              <span class="flex-none text-xs text-fg-subtle">10:42</span>
            </span>
            <span class="flex items-center justify-between gap-2">
              <span class="truncate text-sm text-fg-muted">Tu viens ce soir ?</span>
              <span class="flex-none rounded-full bg-accent px-2 py-0.5 text-xs font-bold text-on-accent">3</span>
            </span>
          </span>
        </a>

        {{-- Conversation de groupe --}}
        <a href="#" class="flex items-center gap-3 border-l-4 border-transparent px-4 py-3 hover:bg-surface-2">
          <span class="flex h-12 w-12 flex-none items-center justify-center rounded-full bg-group-soft font-semibold text-group">PK</span>
          <span class="min-w-0 flex-1">
            <span class="flex items-center justify-between gap-2">
              <span class="truncate font-semibold text-fg">Promo Kadea 2026</span>
              <span class="flex-none text-xs text-fg-subtle">Hier</span>
            </span>
            <span class="block truncate text-sm text-fg-muted">Jo : le projet est rendu</span>
          </span>
        </a>

        {{-- Conversation normale --}}
        <a href="#" class="flex items-center gap-3 border-l-4 border-transparent px-4 py-3 hover:bg-surface-2">
          <span class="flex h-12 w-12 flex-none items-center justify-center rounded-full bg-surface-2 font-semibold text-fg-muted">PM</span>
          <span class="min-w-0 flex-1">
            <span class="flex items-center justify-between gap-2">
              <span class="truncate font-semibold text-fg">Patrick M.</span>
              <span class="flex-none text-xs text-fg-subtle">Lun.</span>
            </span>
            <span class="block truncate text-sm text-fg-muted">Merci beaucoup !</span>
          </span>
        </a>

      </div>
    </section>

    {{-- ===== Zone de discussion (cachée sur téléphone) ===== --}}
    <section class="hidden flex-1 flex-col items-center justify-center p-6 text-center md:flex">
      <span class="flex h-16 w-16 items-center justify-center rounded-2xl bg-primary-soft text-on-primary-soft">
        <svg class="h-8 w-8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
        </svg>
      </span>
      <h2 class="mt-5 text-2xl font-bold text-fg">Bienvenue sur Kadea Chat</h2>
      <p class="mt-2 max-w-sm text-fg-muted">
        Choisissez une conversation dans la liste, ou démarrez-en une nouvelle.
      </p>
    </section>

  </div>

@end