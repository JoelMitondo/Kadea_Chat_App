@layouts.app({ title: 'Messages · Kadea Chat', active: 'messages' })

  {{-- Jeton de sécurité lu par le JavaScript pour ses requêtes --}}
  <input type="hidden" id="csrf-token" value="{{ csrfToken }}">

  {{-- data-view = "list" ou "chat" : sur téléphone, c'est lui qui décide quel panneau est visible --}}
  <div
    id="messages-page"
    data-kind="private"
    data-view="{{ chat ? 'chat' : 'list' }}"
    data-active-id="{{ chat ? chat.id : '' }}"
    data-list-url="/messages"
    data-chat-url="/conversations"
    class="group flex h-full min-h-0"
  >

    {{-- ===== Liste des conversations ===== --}}
    <section class="flex min-h-0 w-full flex-col border-r border-line bg-surface group-data-[view=chat]:hidden md:w-80 md:flex-none md:group-data-[view=chat]:flex lg:w-96">

      <div class="flex flex-none items-center justify-between px-5 py-4">
        <h1 class="text-xl font-bold text-fg">Messages</h1>
        <a href="/users" title="Nouvelle conversation" aria-label="Nouvelle conversation" class="flex h-9 w-9 items-center justify-center rounded-full bg-primary text-on-primary hover:bg-primary-hover">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" viewBox="0 0 24 24">
            <line x1="12" y1="5" x2="12" y2="19" />
            <line x1="5" y1="12" x2="19" y2="12" />
          </svg>
        </a>
      </div>

      <div class="min-h-0 flex-1 overflow-y-auto">

        {{-- État vide (caché par le JavaScript dès qu'il y a une conversation) --}}
        <div id="empty-list" class="{{ conversations.length > 0 ? 'hidden' : '' }} px-6 py-12 text-center">
          <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-primary-soft text-on-primary-soft">
            <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
            </svg>
          </span>
          <p class="mt-4 text-fg-muted">Il n'y a aucune conversation pour le moment. Prière de créer une conversation avec un utilisateur.</p>
        </div>

        <div id="conversations-list">
          @each(item in conversations)
            @!component('components/conversation-item', { item, chatUrl: '/conversations', active: chat ? chat.id === item.id : false, isGroup: false, canDelete: true })
          @end
        </div>
      </div>
    </section>

    {{-- ===== Zone de discussion ===== --}}
    <section id="chat-pane" class="hidden min-h-0 flex-1 flex-col group-data-[view=chat]:flex md:flex">
      @include('partials/chat-panel')
    </section>
  </div>

  {{-- Modèle de l'écran d'accueil, réutilisé par le JavaScript quand on ferme une discussion --}}
  <template id="chat-placeholder">
    @include('partials/chat-empty')
  </template>

  <script src="/resources/js/message.js"></script>

@end