@layouts.app({ title: 'Paramètres · Kadea Chat', active: 'settings' })

  <div class="mx-auto w-full max-w-3xl space-y-6 p-4 sm:p-6">

    <h1 class="text-xl font-bold text-fg">Paramètres</h1>

    {{-- ===== MOT DE PASSE ===== --}}
    <section class="rounded-2xl border border-line bg-surface p-5 shadow-sm sm:p-6">
      <h2 class="text-lg font-bold text-fg">Mot de passe</h2>
      <p class="mt-1 text-fg-muted">Votre mot de passe actuel vous sera demandé.</p>

      <button
        type="button"
        id="open-password-dialog"
        class="mt-4 cursor-pointer rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-on-primary hover:bg-primary-hover"
      >
        Modifier mon mot de passe
      </button>
    </section>

    {{-- ===== UTILISATEURS BLOQUÉS ===== --}}
    <section class="rounded-2xl border border-line bg-surface p-5 shadow-sm sm:p-6">
      <h2 class="text-lg font-bold text-fg">Utilisateurs bloqués</h2>
      <p class="mt-1 text-sm text-fg-muted">Ces personnes ne peuvent plus vous envoyer de nouveaux messages.</p>

      @if(blockedUsers.length === 0)
        <p class="mt-4 text-sm text-fg-subtle">Vous n'avez bloqué personne.</p>
      @else
        <ul class="mt-4 divide-y divide-line rounded-xl border border-line">
          @each(person in blockedUsers)
            <li class="flex items-center gap-3 px-4 py-3">
              @!component('components/user-avatar', { initials: person.initials, src: person.avatarUrl, size: 'sm' })
              <span class="min-w-0 flex-1 truncate font-medium text-fg">{{ person.fullName }}</span>

              {{-- Débloquer : un simple formulaire --}}
              <form action="{{ route('users.unblock', { id: person.id }) }}" method="POST">
                {{ csrfField() }}
                <button type="submit" class="cursor-pointer rounded-lg border border-line-strong px-3 py-2 text-sm font-semibold text-fg hover:bg-surface-2">
                  Débloquer
                </button>
              </form>
            </li>
          @end
        </ul>
      @end
    </section>
        {{-- ===== SUPPRIMER MON COMPTE ===== --}}
    <section class="rounded-2xl border border-danger bg-surface p-5 shadow-sm sm:p-6">
      <h2 class="text-lg font-bold text-danger">Supprimer mon compte</h2>
      <p class="mt-1 text-sm text-fg-muted">
        Cette action est définitive : elle ne peut pas être annulée.
      </p>

      <button
        type="button"
        id="open-delete-dialog"
        class="mt-4 cursor-pointer rounded-lg border border-danger px-4 py-2.5 text-sm font-semibold text-danger hover:bg-danger-soft"
      >
        Supprimer mon compte
      </button>
    </section>
  </div>

  {{-- ===== FENÊTRE : CHANGER MON MOT DE PASSE ===== --}}
  <dialog
    id="password-dialog"
    aria-labelledby="password-dialog-title"
    class="m-auto max-h-[90dvh] w-[calc(100%-2rem)] max-w-md overflow-y-auto rounded-2xl border border-line bg-surface p-0 text-fg shadow-lg backdrop:bg-black/50"
  >
    {{-- data-ajax : envoi sans quitter la page (notifications.js), erreurs affichées sous les champs --}}
    <form
      action="{{ route('settings.password') }}"
      method="POST"
      data-ajax
      data-loading-text="Enregistrement…"
      data-redirect="/settings"
      class="space-y-4 p-6"
    >
      {{ csrfField() }}

      <h2 id="password-dialog-title" class="text-xl font-bold text-fg">Changer mon mot de passe</h2>

      <div>
        <label for="current-password" class="mb-1.5 block text-sm font-medium text-fg">Mot de passe actuel</label>
        {{-- Les erreurs du serveur s'affichent sous ce champ --}}
        <div>
          <input
            id="current-password"
            name="current_password"
            type="password"
            required
            autocomplete="current-password"
            class="w-full rounded-lg border border-line-strong bg-surface px-3.5 py-2.5 text-fg focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/30"
          >
        </div>
      </div>
      <div>
        <label for="new-password" class="mb-1.5 block text-sm font-medium text-fg">Nouveau mot de passe (8 caractères minimum)</label>
        {{-- Les erreurs du serveur s'affichent sous ce champ --}}
        <div>
          <input
            id="new-password"
            name="password"
            type="password"
            required
            minlength="8"
            autocomplete="new-password"
            class="w-full rounded-lg border border-line-strong bg-surface px-3.5 py-2.5 text-fg focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/30"
          >
        </div>
      </div>
      <div>
        <label for="new-password-confirmation" class="mb-1.5 block text-sm font-medium text-fg">Confirmez le nouveau mot de passe</label>
        {{-- Les erreurs du serveur s'affichent sous ce champ --}}
        <div>
          <input
            id="new-password-confirmation"
            name="password_confirmation"
            type="password"
            required
            minlength="8"
            autocomplete="new-password"
            class="w-full rounded-lg border border-line-strong bg-surface px-3.5 py-2.5 text-fg focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/30"
          >
        </div>
      </div>

      <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
        <button type="button" data-modal-close class="cursor-pointer rounded-lg border border-line-strong px-4 py-2.5 font-semibold text-fg hover:bg-surface-2">
          Annuler
        </button>
        <button type="submit" class="cursor-pointer rounded-lg bg-primary px-4 py-2.5 font-semibold text-on-primary hover:bg-primary-hover disabled:cursor-not-allowed disabled:opacity-60">
          Enregistrer
        </button>
      </div>
    </form>

    {{-- Mot de passe actuel oublié : on passe par le lien envoyé par e-mail --}}
    <form action="{{ route('settings.password.forgot') }}" method="POST" class="border-t border-line px-6 py-4">
      {{ csrfField() }}
      <button type="submit" class="cursor-pointer text-sm font-medium text-primary underline">
        Mot de passe actuel oublié ? Recevoir un lien par e-mail
      </button>
      <p class="mt-1 text-xs text-fg-subtle">Vous serez déconnecté(e) puis dirigé(e) vers « Mot de passe oublié ».</p>
    </form>
  </dialog>

    {{-- ===== FENÊTRE : SUPPRIMER MON COMPTE ===== --}}
  <dialog
    id="delete-dialog"
    aria-labelledby="delete-dialog-title"
    class="m-auto max-h-[90dvh] w-[calc(100%-2rem)] max-w-md overflow-y-auto rounded-2xl border border-line bg-surface p-0 text-fg shadow-lg backdrop:bg-black/50"
  >
    {{-- data-ajax : envoi sans quitter la page (notifications.js), comme les autres formulaires --}}
    <form
      action="{{ route('settings.delete') }}"
      method="POST"
      data-ajax
      data-success="Votre compte a été supprimé définitivement."
      data-loading-text="Suppression…"
      data-redirect="/"
      class="space-y-4 p-6"
    >
      {{ csrfField() }}

      <h2 id="delete-dialog-title" class="text-xl font-bold text-danger">Supprimer définitivement mon compte ?</h2>

      <p class="text-sm text-fg-muted">Voici ce qui sera supprimé :</p>
      <ul class="list-disc space-y-1 pl-5 text-sm text-fg-muted">
        <li>votre profil et votre photo ;</li>
        <li>vos conversations privées, <strong>aussi chez l'autre personne</strong> ;</li>
        <li>vos messages dans les groupes ;</li>
        <li>les groupes dont vous êtes le seul membre.</li>
      </ul>
      <p class="text-sm text-fg-muted">
        Dans les groupes que vous administrez, le membre le plus ancien devient administrateur.
      </p>

      <div>
        <label for="delete-password" class="mb-1.5 block text-sm font-medium text-fg">Entrez votre mot de passe pour confirmer</label>
        {{-- Les erreurs du serveur s'affichent sous ce champ --}}
        <div>
          <input
            id="delete-password"
            name="password"
            type="password"
            required
            autocomplete="current-password"
            class="w-full rounded-lg border border-line-strong bg-surface px-3.5 py-2.5 text-fg focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/30"
          >
        </div>
      </div>

      <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
        <button type="button" data-modal-close class="cursor-pointer rounded-lg border border-line-strong px-4 py-2.5 font-semibold text-fg hover:bg-surface-2">
          Annuler
        </button>
        <button type="submit" class="cursor-pointer rounded-lg bg-danger px-4 py-2.5 font-semibold text-surface hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-60">
          Supprimer définitivement
        </button>
      </div>
    </form>
  </dialog>

  @vite(['resources/js/settings.js'])

@end