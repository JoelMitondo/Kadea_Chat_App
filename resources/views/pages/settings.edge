@layouts.app({ title: 'Paramètres · Kadea Chat', active: 'settings' })

  <div class="mx-auto w-full max-w-3xl space-y-6 p-4 sm:p-6">

    <h1 class="text-xl font-bold text-fg">Paramètres</h1>

    {{-- ===== MOT DE PASSE ===== --}}
    <section class="rounded-2xl border border-line bg-surface p-5 shadow-sm sm:p-6">
      <h2 class="text-lg font-bold text-fg">Mot de passe</h2>
      <p class="mt-1 text-fg-muted">Souhaitez-vous modifier votre mot de passe ?</p>

      <button
        type="button"
        id="open-password-dialog"
        class="mt-4 cursor-pointer rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-on-primary hover:bg-primary-hover"
      >
        Oui, modifier mon mot de passe
      </button>
    </section>

    {{-- ===== UTILISATEURS BLOQUÉS ===== --}}
    <section class="rounded-2xl border border-line bg-surface p-5 shadow-sm sm:p-6">
      <h2 class="text-lg font-bold text-fg">Utilisateurs bloqués</h2>
      <p class="mt-1 text-sm text-fg-muted">Ces personnes ne peuvent plus vous envoyer de nouveaux messages.</p>

      @if(blockedUsers.length === 0)
        <p class="mt-4 text-sm text-fg-subtle">Vous n'avez bloqué personne.</p>
      @else
        <ul class="mt-4 divide-y divide-line rounded-xl border border-line">
          @each(person in blockedUsers)
            <li class="flex items-center gap-3 px-4 py-3">
              @!component('components/user-avatar', { initials: person.initials, src: person.avatarUrl, size: 'sm' })
              <span class="min-w-0 flex-1 truncate font-medium text-fg">{{ person.fullName }}</span>

              {{-- Débloquer : un simple formulaire --}}
              <form action="{{ route('users.unblock', { id: person.id }) }}" method="POST">
                {{ csrfField() }}
                <button type="submit" class="cursor-pointer rounded-lg border border-line-strong px-3 py-2 text-sm font-semibold text-fg hover:bg-surface-2">
                  Débloquer
                </button>
              </form>
            </li>
          @end
        </ul>
      @end
    </section>
  </div>

  {{-- ===== FENÊTRE : ACCÈS À L'ADRESSE E-MAIL ===== --}}
  <dialog
    id="password-dialog"
    aria-labelledby="password-dialog-title"
    class="m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl border border-line bg-surface p-0 text-fg shadow-lg backdrop:bg-black/50"
  >
    <div class="p-6">
      <h2 id="password-dialog-title" class="text-xl font-bold text-fg">Avez-vous toujours accès à votre adresse e-mail ?</h2>

      <p class="mt-3 text-fg-muted">
        Un lien de réinitialisation sera envoyé à votre adresse e-mail.
      </p>
      <p class="mt-2 text-sm text-fg-muted">
        Si vous continuez, vous serez <strong>déconnecté(e)</strong> et dirigé(e) vers la page
        « Mot de passe oublié », où vous saisirez votre adresse e-mail.
      </p>

      <div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
        {{-- Non : on ferme simplement la fenêtre --}}
        <button type="button" data-modal-close class="cursor-pointer rounded-lg border border-line-strong px-4 py-2.5 font-semibold text-fg hover:bg-surface-2">
          Non, annuler
        </button>

        {{-- Oui : le formulaire déconnecte l'utilisateur et le redirige --}}
        <form action="{{ route('settings.password') }}" method="POST">
          {{ csrfField() }}
          <button type="submit" class="w-full cursor-pointer rounded-lg bg-primary px-4 py-2.5 font-semibold text-on-primary hover:bg-primary-hover">
            Oui, j'y ai accès
          </button>
        </form>
      </div>
    </div>
  </dialog>

  <script src="/resources/js/settings.js"></script>

@end